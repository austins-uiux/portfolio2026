{
  "name": "aplus-studio-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "node scripts/check-assets.mjs && tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build:preview": "node scripts/build-preview.mjs",
    "sync:components": "python3 scripts/sync-shadcn.py",
    "sync:interactions": "python3 scripts/sync-magicui.py",
    "check:assets": "node scripts/check-assets.mjs",
    "check:utlab": "node scripts/check-ut-lab.mjs",
    "predev": "node scripts/build-chat-context.mjs",
    "prebuild": "node scripts/build-chat-context.mjs && node scripts/check-chat-build.mjs",
    "prebuild:preview": "node scripts/build-chat-context.mjs",
    "check:chat": "node scripts/build-chat-context.mjs && node --experimental-strip-types scripts/check-chat.mjs && node scripts/check-chat-build.mjs",
    "postbuild": "node scripts/prerender.mjs && node scripts/check-prerender.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.1",
    "react-resizable-panels": "^4.15.0",
    "react-tweet": "^3.3.1",
    "recharts": "^3.8.0",
    "rough-notation": "^0.5.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
